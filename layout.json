         {"type": "button", "label": "R", "btype": "rotate_cw", "halign": "fill", "uid": "redo",
          "on_event": "redo_on_event"},
         {"type": "button", "btype": "cancel", "halign": "fill", "uid": "glyph_del",
          "on_event": "glyph_del_on_event"},
         {"type": "button", "btype": "copy", "halign": "fill", "on_event": "copy_on_event"},
         {"type": "button", "btype": "paste", "halign": "fill", "uid": "paste",
          "on_event": "paste_on_event"},
         {"type": "button", "btype": "left", "halign": "fill", "on_event": "move_left_on_event"},
         {"type": "button", "btype": "right", "halign": "fill", "on_event": "move_right_on_event"},
         {"type": "button", "btype": "up", "halign": "fill", "on_event": "move_up_on_event"},
         {"type": "button", "btype": "down", "halign": "fill", "on_event": "move_down_on_event"},
         {"type": "button", "btype": "mirror_h", "halign": "fill", "on_event": "flip_h_on_event"},
         {"type": "button", "btype": "mirror_v", "halign": "fill", "on_event": "flip_v_on_event"},
         {"type": "spinner", "min": 1, "max": 64, "val": 1, "uid": "canvas_zoom",
          "on_event": "canvas_zoom_on_event"}
       ]}
     ], "cell-fill": "1, 0"},
     {"type": "vbox", "align": "fill", "border": "none", "widgets": [
       {"type": "hbox", "halign": "fill", "border": "none", "widgets": [
         {"type": "spinbutton", "desc": "blocks_desc", "uid": "blocks",
          "on_event": "blocks_on_event"},
         {"type": "tbox", "uid": "block_start", "len": 5, "tattr": "mono",
          "on_event": "block_start_on_event"},
         {"type": "button", "btype": "add", "halign": "fill", "uid": "block_add",
          "on_event": "block_add_on_event"},
         {"type": "button", "btype": "clear", "halign": "fill", "uid": "block_del",
          "on_event": "block_del_on_event"},
         {"type": "button", "btype": "rem", "halign": "fill", "uid": "range_del",
          "on_event": "glyph_range_del_on_event"},
         {"type": "spinner", "min": 1, "max": 8, "val": 2, "uid": "zoom",
          "on_event": "zoom_on_event"}
       ], "cell-fill": "2 * 0, 3*4, 0"},
       {"type": "pixmap", "w": "0px 4pad 32asc", "h": "0px 4pad 22asc",
        "align": "fill", "uid": "browser", "on_event": "browser_on_event"},
       {"type": "hbox", "align": "fill", "border": "none", "widgets": [
        {"type": "pixmap", "w": "0px 4pad 30asc", "h": "0px 2pad 7asc",
         "align": "fill", "uid": "deps", "on_event": "deps_on_event"},
        {"type": "checkbox", "label": "update", "uid": "update",
         "on_event": "update_on_event"}
       ]}
     ], "cell-fill": "0, 5, 1"}
   ]},
   {"type": "hbox", "border": "none", "align": "fill", "widgets": [
     {"type": "label", "uid": "status", "text": "", "tattr": "mono", "align": "center"},
     {"type": "grid", "uniform": true, "border": 0, "cols": 3, "rows": 2, "widgets": [
      {"type": "label", "text": "bearing x"},
      {"type": "spinner", "min": -32, "max": 64, "val": 0, "uid": "bearing_x",
       "on_event": "bearing_x_on_event", "halign": "fill"},
      {"type": "label", "text": "bearing y"},
      {"type": "spinner", "min": -32, "max": 64, "val": 0, "uid": "bearing_y",
       "on_event": "bearing_y_on_event", "halign": "fill"},
      {"type": "label", "text": "advance x"},
      {"type": "spinner", "min": 0, "max": 64, "val": 0, "uid": "advance",
       "on_event": "advance_on_event", "halign": "fill"}
      ]
     },
     {"type": "pixmap", "w": "0px 8pad 26asc", "h": "0px 2pad 5asc", "uid": "strip",
      "on_event": "strip_on_event"},
     {"type": "button", "btype": "clear", "align": "fill", "on_event": "glyph_clear_on_event"}
   ]},
   {"type": "hbox", "halign": "fill", "border": "none", "widgets": [
     {"type": "tbox", "uid": "preview_text", "len": 40, "halign": "fill",
      "help": "preview text", "on_event": "preview_text_on_event"},
     {"type": "checkbox", "label": "underline", "on_event": "rule_under_on_event"},
     {"type": "checkbox", "label": "line through", "on_event": "rule_strike_on_event"},
     {"type": "checkbox", "label": "overline", "on_event": "rule_over_on_event"}
   ], "cell-fill": "1, 0, 0, 0"},
   {"type": "pixmap", "w": "0px 4pad 40asc", "h": "160px", "align": "fill",
    "uid": "preview", "on_event": "preview_on_event"},
   {"type": "label", "uid": "lint", "text": "",
    "tattr": "mono|left", "halign": "fill"}
  ], "cell-fill": "0, 1, 0, 0, 1, 0"
 }
}
