 "info": {"version": 1, "license": "GPL-2.0-or-later"},
 "layout": {
  "type": "vbox",
  "align": "fill",
  "widgets": [
   {"type": "hbox", "border": "none", "halign": "fill", "widgets": [
    {"type": "label", "uid": "family", "text": "", "tattr": "bold"},
    {"type": "button", "label": "Open", "btype": "open", "on_event": "open_on_event"},
    {"type": "button", "label": "Save", "btype": "save", "uid": "save",
     "on_event": "save_on_event"},
    {"type": "button", "label": "Export", "btype": "save", "uid": "export",
     "on_event": "export_on_event"},
    {"type": "button", "label": "New", "btype": "add", "on_event": "new_on_event"},
    {"type": "button", "label": "Font", "btype": "settings", "uid": "family_button",
     "on_event": "family_on_event"},
    {"type": "label", "uid": "lint_errors", "frame": true, "text": "", "text_color": "alert",
     "tattr": "bold|center", "bg_color": "fg", "width": 2},
    {"type": "label", "uid": "lint_warnings", "frame": true, "text": "", "text_color": "warn",
     "tattr": "bold|center", "bg_color": "fg", "width": 2},
    {"type": "button", "label": "lint", "btype": "next", "uid": "lint_button",
     "on_event": "lint_on_event"}
   ], "padd-fill": "0, 4, 0, 0, 0, 0, 0, 0, 0, 0", "cell-fill": "9*0"},
   {"type": "hbox", "align": "fill", "border": "none", "widgets": [
     {"type": "vbox", "align": "fill", "border": "none", "widgets": [
